{
  "name": "ppt-plan-studio",
  "version": "0.1.0",
  "private": true,
  "description": "A desktop AI workspace for planning and beautifying editable PowerPoint decks.",
  "main": "dist/main/main/main.js",
  "scripts": {
    "dev": "npm run build:main && concurrently -k --success last \"vite --config vite.config.ts\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build --config vite.config.ts",
    "build:main": "tsc -p tsconfig.main.json",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:desktop": "npm run build && node tests/desktop.smoke.mjs",
    "package:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.0.1",
    "@napi-rs/canvas": "^1.0.10",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.5",
    "typebox": "^1.3.34"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^10.0.0",
    "electron": "44.5.1",
    "electron-builder": "^26.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "build": {
    "appId": "local.pptplan.studio",
    "productName": "PPT Plan Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "resources/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dir"
    }
  }
}
